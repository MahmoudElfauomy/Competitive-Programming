vector<int> primes, is_prime, spf;
void linear_sieve(int n)
{
    primes.clear();
    is_prime.assign(n + 1, 1);
    spf.assign(n + 1, 0);

    is_prime[0] = is_prime[1] = 0;
    spf[0] = 0, spf[1] = 1;

    for (int i = 2; i <= n; i++)
    {
        if (is_prime[i])
        {
            primes.push_back(i);
            spf[i] = i;
        }

        for (auto p : primes)
        {
            if (i * p > n || p > spf[i]) break;
            is_prime[i * p] = 0;
            spf[i * p] = p;
        }
    }
}
