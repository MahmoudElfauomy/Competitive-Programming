bool Knowbit(ll n , ll x )
{
    return ( n >> x ) & 1 ;  
}
ll Setbit ( ll n , ll x ) 
{
return ( n | ( 1 << x ) ) ;
}
ll Resetbit ( ll n , ll x )
{
    return  ( n & ( ~ ( 1 << x ) ) ) ;
    // or 
//  return ( n & ( -1 ^ ( 1 << x ) ) ) ;
}
ll Flip ( ll n , ll x )
{
    return ( n ^ ( 1 << x ) );
}
bool IsPowerOfTwo ( ll n )
{
    if ( n == 0 ) return 0 ; 
    return ! ( n & ( n - 1 )) ;
