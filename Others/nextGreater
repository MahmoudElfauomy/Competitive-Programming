vector<pair<int, int>> nextGreaterElement(vector<int>& v)
{
    int n = v.size();
    vector<pair<int, int>> res(n, {-1, -1});
    stack<int> st;

    for (int i = 0; i < n; i++)
    {
        while (!st.empty() && v[i] > v[st.top()])
        {
            res[st.top()] = {v[i], i};
            st.pop();
        }
        st.push(i);
    }
    return res;
}
